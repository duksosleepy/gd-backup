# Google Drive Automated Backup Configuration

# Local directory to backup (relative or absolute path)
BACKUP_SOURCE_DIR=./data_to_backup

# Google Drive target folder ID (leave blank to backup to root or specified at run time)
GDRIVE_FOLDER_ID=

# Path to Google OAuth client secret JSON downloaded from Google Cloud Console
GDRIVE_CREDENTIALS_FILE=credentials.json

# Path to save/read Google OAuth user token
GDRIVE_TOKEN_FILE=token.json

# Default schedule interval in hours (configurable in code in backup.py as well)
BACKUP_SCHEDULE_HOURS=24

# Web UI server binding
HOST=0.0.0.0
PORT=8100
